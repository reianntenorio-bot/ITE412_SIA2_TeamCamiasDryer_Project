# ImgBB (recommended - free, no billing): Get API key at https://api.imgbb.com/
IMGBB_API_KEY=your_imgbb_api_key

# Firestore (required on Railway - credentials file is gitignored):
# Paste full service account JSON as single line. Check /status to verify.
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# Google Drive (optional - service accounts have storage quota limits):
# GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here
# GOOGLE_DRIVE_CREDENTIALS_FILE=./credentials.json
# Or use GOOGLE_DRIVE_CREDENTIALS_JSON for Railway (same format as FIREBASE_CREDENTIALS_JSON)
