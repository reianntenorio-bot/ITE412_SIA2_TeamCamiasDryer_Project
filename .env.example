# Copy to .env and fill in values from Firebase Console → Project settings → Your apps → Web app config.
# Restart the dev server after changing this file.

# Required — copy from Firebase Console → Project settings → Your apps → Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=kamyasdryer-dae01.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=kamyasdryer-dae01
VITE_FIREBASE_STORAGE_BUCKET=kamyasdryer-dae01.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=https://kamyasdryer-dae01-default-rtdb.firebaseio.com

# Local dev: keep this on localhost. Production (Vercel) should use your Railway URL.
VITE_API_URL=http://localhost:3001

# PayMongo (server-side secret — never expose in frontend)
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
